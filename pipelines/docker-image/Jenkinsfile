pipeline {
    agent any

    parameters {
        booleanParam(
                name: 'PUSH_IMAGE',
                defaultValue: false,
                description: 'Push the Docker image to the registry after a successful build.'
        )
    }

    environment {
        IMAGE_NAME = 'joaoscioli/spring-boot-api'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        REGISTRY_CREDENTIALS_ID = 'docker-registry-credentials'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                sh './mvnw -B --no-transfer-progress verify'
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/TEST-*.xml', allowEmptyResults: false
                }
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true, allowEmptyArchive: false
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    : "${GIT_COMMIT:?GIT_COMMIT must be set}"
                    : "${IMAGE_NAME:?IMAGE_NAME must be set}" "${IMAGE_TAG:?IMAGE_TAG must be set}"
                    docker build --label "org.opencontainers.image.revision=$GIT_COMMIT" -t "$IMAGE_NAME:$IMAGE_TAG" .
                '''
            }
        }

        stage('Inspect Image') {
            steps {
                sh '''
                    set -eu
                    : "${GIT_COMMIT:?GIT_COMMIT must be set}"
                    : "${IMAGE_NAME:?IMAGE_NAME must be set}" "${IMAGE_TAG:?IMAGE_TAG must be set}"
                    revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$IMAGE_NAME:$IMAGE_TAG")
                    if [ "$revision" != "$GIT_COMMIT" ]; then
                        echo 'Image revision does not match the checked-out commit' >&2
                        exit 1
                    fi
                '''
            }
        }

        stage('Push Docker Image') {
            when {
                expression { params.PUSH_IMAGE }
            }
            steps {
                withCredentials([
                        usernamePassword(
                                credentialsId: env.REGISTRY_CREDENTIALS_ID,
                                usernameVariable: 'REGISTRY_USERNAME',
                                passwordVariable: 'REGISTRY_PASSWORD'
                        )
                ]) {
                    withEnv(["DOCKER_CONFIG=${pwd(tmp: true)}/docker-config"]) {
                        sh '''
                            set -eu
                            : "${IMAGE_NAME:?IMAGE_NAME must be set}" "${IMAGE_TAG:?IMAGE_TAG must be set}"
                            : "${REGISTRY_USERNAME:?REGISTRY_USERNAME must be set}" "${REGISTRY_PASSWORD:?REGISTRY_PASSWORD must be set}"
                            trap 'docker logout >/dev/null 2>&1 || true' EXIT
                            printf '%s' "$REGISTRY_PASSWORD" | docker login -u "$REGISTRY_USERNAME" --password-stdin
                            docker push "$IMAGE_NAME:$IMAGE_TAG"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Docker pipeline completed for $IMAGE_NAME:$IMAGE_TAG."
        }
        failure {
            echo 'Docker pipeline failed. Check build, image, and credentials logs.'
        }
    }
}
